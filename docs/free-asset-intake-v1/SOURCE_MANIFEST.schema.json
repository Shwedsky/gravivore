{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRAVIVORE Free Asset Intake V1 source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intakeRoot",
    "licenseClasses",
    "productionPolicy",
    "fallbackFolders",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "intakeRoot": {
      "const": "ExternalAssetIntake/FreeAssetIntakeV1"
    },
    "licenseClasses": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "UNITY_ASSET_STORE_EULA",
          "CC0",
          "CC_BY_4_0",
          "CUSTOM_FREE_COMMERCIAL",
          "UNKNOWN_REQUIRES_REVIEW"
        ]
      }
    },
    "productionPolicy": {
      "type": "string",
      "minLength": 1
    },
    "fallbackFolders": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ExternalAssetIntake/FreeAssetIntakeV1/98_unclassified",
          "ExternalAssetIntake/FreeAssetIntakeV1/99_failed_or_replacements"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "category",
          "expectedLocalFolder",
          "sourceUrl",
          "publisher",
          "sourcePlatform",
          "expectedLicense",
          "attributionRequired",
          "intendedRoles",
          "priority",
          "downloadStatus",
          "inspectionStatus",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "expectedLocalFolder": {
            "type": "string",
            "pattern": "^ExternalAssetIntake/FreeAssetIntakeV1/[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$"
          },
          "sourceUrl": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https?://[^\\s]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "sourcePlatform": {
            "type": "string",
            "minLength": 1
          },
          "expectedLicense": {
            "enum": [
              "UNITY_ASSET_STORE_EULA",
              "CC0",
              "CC_BY_4_0",
              "CUSTOM_FREE_COMMERCIAL",
              "UNKNOWN_REQUIRES_REVIEW"
            ]
          },
          "attributionRequired": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "intendedRoles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "priority": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "downloadStatus": {
            "const": "AWAITING_OWNER_DOWNLOAD"
          },
          "inspectionStatus": {
            "const": "NOT_INSPECTED"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
